{
  "name": "isiege",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "express": "^5.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.17.0",
    "web-vitals": "^2.1.4",
    "ws": "^8.21.0"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "test": "jest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:debug": "npx --node-options='--inspect-brk' jest",
    "preview": "vite preview",
    "server:dev": "ts-node-dev --project server/tsconfig.json --require tsconfig-paths/register --respawn --transpile-only server/index.ts",
    "server:build": "tsc --project server/tsconfig.json",
    "dev": "concurrently -n server,client -c cyan,green \"npm run server:dev\" \"npm start\"",
    "build:all": "npm run build && npm run server:build"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "pretty-quick": "^4.2.2",
    "simple-git-hooks": "^2.13.0",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
