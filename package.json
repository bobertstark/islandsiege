{
  "name": "isiege",
  "version": "0.1.0",
  "private": true,
  "proxy": "http://localhost:3001",
  "dependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "express": "^5.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.17.0",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4",
    "ws": "^8.21.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:debug": "npx --node-options='--inspect-brk' jest",
    "server:dev": "ts-node-dev --project server/tsconfig.json --require tsconfig-paths/register --respawn --transpile-only server/index.ts",
    "server:build": "tsc --project server/tsconfig.json",
    "dev": "concurrently -n server,client -c cyan,green \"npm run server:dev\" \"npm start\"",
    "build:all": "npm run build && npm run server:build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.27.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.3",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "pretty-quick": "^4.2.2",
    "simple-git-hooks": "^2.13.0",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "<5"
  }
}
